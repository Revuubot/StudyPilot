# ──────────────────────────────────────────────
# StudyPilot Environment Configuration
# Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://studypilot:studypilot@postgres:5432/studypilot
DATABASE_URL_SYNC=postgresql://studypilot:studypilot@postgres:5432/studypilot
POSTGRES_USER=studypilot
POSTGRES_PASSWORD=studypilot
POSTGRES_DB=studypilot

# ── Redis / Celery ────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Auth / JWT ────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Gemini API (Google AI) ────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── OpenAI Whisper (fallback transcription) ───
OPENAI_API_KEY=your-openai-api-key-here

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ── Weights & Biases (optional) ──────────────
WANDB_API_KEY=
WANDB_PROJECT=studypilot

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email (optional) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
